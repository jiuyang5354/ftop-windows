<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ftop.Core\Ftop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows-only sensor APIs; inbox on the build machine, explicit here
         so the class library stays honest about what it needs. -->
